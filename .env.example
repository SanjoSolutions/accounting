DATABASE_URL=file:./accounting.db

AUTH_MODE=credentials
# Required and loopback-only if AUTH_MODE=none is configured manually. Prefer
# `pnpm solo`, which sets this safely and refuses hostname overrides.
# APP_BIND_HOST=127.0.0.1
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# BETTER_AUTH_DISABLE_SIGN_UP=false

# ELSTER ERiC 44 / E-Bilanz 6.9. Build tools/eric-bridge first and point to
# its executable. Obtain your own manufacturer ID in the ELSTER developer area.
# Never store the certificate PIN here; it is entered only for an explicit send.
# ERIC_BRIDGE_PATH=C:\absolute\path\to\EricBridge.exe
# ERIC_RUNTIME_DIR=C:\absolute\path\to\ERiC-44.2.4.0\Windows-x86_64\dll
# ERIC_HERSTELLER_ID=
# ERIC_CERTIFICATE_PATH=C:\absolute\path\to\certificate.pfx
# ERIC_TESTMERKER=700000004

# Apache OpenDAL document storage. The default stores files in ./storage.
DOCUMENT_STORAGE_DRIVER=fs
DOCUMENT_STORAGE_ROOT=./storage
DOCUMENT_STORAGE_REGION=local
DOCUMENT_STORAGE_MAX_UPLOAD_BYTES=20971520
DOCUMENT_EXTRACTION_TIMEOUT_MS=10000

# Operator-approved receivables reminder delivery. The gateway must accept the
# documented version-1 JSON contract, honor Idempotency-Key, and return a JSON
# messageId. Plain HTTP is accepted only for a loopback development emulator.
# REMINDER_EMAIL_GATEWAY_URL=https://mail-gateway.example.com/reminders
# REMINDER_EMAIL_GATEWAY_CREDENTIAL=

# Compliance integrity and backup encryption. Generate independent random keys;
# retain old key IDs in the JSON keyring for the full backup retention period.
# AUDIT_INTEGRITY_KEYS={"audit-2026":"AT_LEAST_32_RANDOM_CHARACTERS"}
# AUDIT_INTEGRITY_KEY_ID=audit-2026
# A single-key deployment may instead use AUDIT_INTEGRITY_SECRET.
# AUDIT_INTEGRITY_SECRET=
# COMPLIANCE_BACKUP_KEYS_BASE64={"key-2026":"BASE64_ENCODED_32_BYTE_KEY"}
# A single-key deployment may instead set both values below.
# COMPLIANCE_BACKUP_KEY_ID=key-2026
# COMPLIANCE_BACKUP_KEY_BASE64=

# S3 / S3-compatible storage
# DOCUMENT_STORAGE_DRIVER=s3
# DOCUMENT_STORAGE_BUCKET=
# DOCUMENT_STORAGE_REGION=
# DOCUMENT_STORAGE_ENDPOINT=
# DOCUMENT_STORAGE_ACCESS_KEY_ID=
# DOCUMENT_STORAGE_SECRET_ACCESS_KEY=

# Google Cloud Storage
# DOCUMENT_STORAGE_DRIVER=gcs
# DOCUMENT_STORAGE_BUCKET=
# DOCUMENT_STORAGE_CREDENTIAL_PATH=

# Azure Blob Storage
# DOCUMENT_STORAGE_DRIVER=azblob
# DOCUMENT_STORAGE_CONTAINER=
# DOCUMENT_STORAGE_ENDPOINT=https://ACCOUNT.blob.core.windows.net
# DOCUMENT_STORAGE_ACCOUNT_NAME=
# DOCUMENT_STORAGE_ACCOUNT_KEY=

# Additional OpenDAL options can be supplied as a JSON object. They override
# the named options above.
# DOCUMENT_STORAGE_OPTIONS={"root":"accounting"}
# Optional authorized ELSTER gateway qualification contract. Keep disabled for normal CI.
QUALIFIED_TAX_GATEWAY_CONTRACT_ENABLED=false
QUALIFIED_TAX_GATEWAY_CONTRACT_URL=
QUALIFIED_TAX_GATEWAY_CONTRACT_CREDENTIAL=
QUALIFIED_TAX_GATEWAY_CONTRACT_TAXPAYER_ID=
QUALIFIED_TAX_GATEWAY_CONTRACT_GATEWAY_ID=
QUALIFIED_TAX_GATEWAY_CONTRACT_QUALIFICATION_ID=
QUALIFIED_TAX_GATEWAY_CONTRACT_FORM_VERSIONS=USTVA-2025.1,UST_ANNUAL-2025.1,KST-2025.1,GEWST-2025.1,USTVA-2026.1,UST_ANNUAL-2026.1,KST-2026.1,GEWST-2026.1
QUALIFIED_TAX_GATEWAY_CONTRACT_ALLOW_SUBMISSION=false
QUALIFIED_TAX_GATEWAY_CONTRACT_PROTOCOL_DIR=

# Manual Unternehmensregister Webservice qualification. Official interface
# specifications and TEST/STAGING access are issued by the platform provider.
# Never enable this without an electronically identified authorized submitter.
QUALIFIED_DISCLOSURE_CONTRACT_ENABLED=false
QUALIFIED_DISCLOSURE_CONTRACT_URL=
QUALIFIED_DISCLOSURE_CONTRACT_CREDENTIAL=
QUALIFIED_DISCLOSURE_CONTRACT_SUBMITTER_ID=
QUALIFIED_DISCLOSURE_CONTRACT_GATEWAY_ID=
QUALIFIED_DISCLOSURE_CONTRACT_QUALIFICATION_ID=
QUALIFIED_DISCLOSURE_CONTRACT_SCHEMA_VERSION=
QUALIFIED_DISCLOSURE_CONTRACT_CASES=MICRO-HINTERLEGUNG,SMALL-OFFENLEGUNG
QUALIFIED_DISCLOSURE_CONTRACT_ALLOW_SUBMISSION=false
QUALIFIED_DISCLOSURE_CONTRACT_PROTOCOL_DIR=

# Manual validation-only ERiC Bilanz_6.9 contract. These values are intentionally
# separate from production certificate/PIN configuration. Never add either secret.
ERIC_QUALIFICATION_CONTRACT_ENABLED=false
ERIC_QUALIFICATION_AUTHORIZED_TEST_MODE=false
ERIC_QUALIFICATION_BRIDGE_PATH=
ERIC_QUALIFICATION_RUNTIME_DIR=
ERIC_QUALIFICATION_MANUFACTURER_ID=
ERIC_QUALIFICATION_TEST_MARKER=
ERIC_QUALIFICATION_TEST_TAX_NUMBER=
ERIC_QUALIFICATION_SAMPLE_XBRL=
ERIC_QUALIFICATION_EXPECTED_OUTCOME=TEST_MARKER_RESPONSE
ERIC_QUALIFICATION_EXPECTED_STATUS_CODE=
ERIC_QUALIFICATION_EXPECTED_STATUS_TEXT=
ERIC_QUALIFICATION_EVIDENCE_DIR=

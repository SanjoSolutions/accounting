generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AccountRecord {
  id        String   @id
  ownerId   String?  @unique
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfileVersion {
  id            String    @id @default(cuid())
  ownerId       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  payload       String
  createdBy     String
  reason        String
  createdAt     DateTime  @default(now())

  @@unique([ownerId, effectiveFrom])
  @@index([ownerId, effectiveFrom, effectiveTo])
}

model CompanyProfileAddressConfirmation {
  id               String   @id @default(cuid())
  ownerId          String
  profileVersionId String   @unique
  payload          String
  createdBy        String
  reason           String
  createdAt        DateTime @default(now())

  @@index([ownerId, createdAt])
}

model AuditEvent {
  id             String   @id
  ownerId        String
  actorId        String
  occurredAt     DateTime
  action         String
  reason         String
  objectType     String
  objectId       String
  semanticDelta  String
  previousHash   String?
  hash           String
  integrityKeyId String   @default("default")
  createdAt      DateTime @default(now())

  @@unique([ownerId, hash])
  @@index([ownerId, occurredAt])
}

model AuditHead {
  ownerId          String   @id
  headHash         String?
  legacyHeadHash   String?
  legacyEventCount Int      @default(0)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model BackupManifest {
  id                String    @id @default(cuid())
  ownerId           String
  createdAt         DateTime  @default(now())
  databaseHash      String
  objectStoreHash   String
  encryptionKeyId   String
  storageRegion     String
  recoveryPointAt   DateTime
  verifiedAt        DateTime?
  restoredAt        DateTime?
  manifest          String
  payloadStorageKey String?
  status            String    @default("CREATED")

  @@index([ownerId, createdAt])
}

model CompliancePolicy {
  ownerId                       String   @id
  allowedStorageRegions         String
  operatorIds                   String
  recoveryPointObjectiveMinutes Int
  recoveryTimeObjectiveMinutes  Int
  backupKeyId                   String
  updatedAt                     DateTime @updatedAt
}

model CompliancePackage {
  id             String    @id
  ownerId        String
  kind           String
  fiscalPeriodId String?
  version        Int
  status         String
  payload        String
  checksum       String
  storageKey     String?
  supersedesId   String?
  authorityRef   String?
  createdBy      String
  createdAt      DateTime  @default(now())
  approvedBy     String?
  approvedAt     DateTime?

  @@unique([ownerId, kind, fiscalPeriodId, version])
  @@unique([ownerId, checksum])
  @@index([ownerId, kind, createdAt])
}

model ProcedureDocumentRecord {
  id            String    @id
  ownerId       String
  documentId    String
  version       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  payload       String
  checksum      String
  approvedBy    String
  approvedAt    DateTime
  createdAt     DateTime  @default(now())

  @@unique([ownerId, documentId, version])
  @@index([ownerId, effectiveFrom, effectiveTo])
}

model FixedAssetRecord {
  id                       String   @id
  ownerId                  String
  payload                  String
  acquisitionJournalLineId String?  @unique
  createdBy                String
  createdAt                DateTime @default(now())

  @@index([ownerId, createdAt])
}

model AssetEventRecord {
  id         String   @id
  ownerId    String
  assetId    String
  sequence   Int
  payload    String
  postingId  String
  approvedBy String
  approvedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([ownerId, assetId, sequence])
  @@index([ownerId, assetId, createdAt])
}

model InventoryItemRecord {
  id        String   @id
  ownerId   String
  payload   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model InventoryCountSnapshot {
  id             String   @id
  ownerId        String
  fiscalPeriodId String
  payload        String
  checksum       String
  closedBy       String
  closedAt       DateTime
  createdAt      DateTime @default(now())

  @@unique([ownerId, fiscalPeriodId])
  @@index([ownerId, closedAt])
}

model CashBookRecord {
  id              String   @id
  ownerId         String
  location        String
  register        String
  timeZone        String
  currency        String
  glAccountId     String
  retainedThrough DateTime
  createdAt       DateTime @default(now())

  @@unique([ownerId, location, register])
  @@index([ownerId, createdAt])
}

model CashEntryRecord {
  id                 String   @id
  ownerId            String
  cashBookId         String
  sequence           Int
  businessDate       DateTime
  journalEntryId     String
  payload            String
  correctsEntryId    String?
  replacementEntryId String?
  createdAt          DateTime @default(now())

  @@unique([ownerId, cashBookId, sequence])
  @@unique([ownerId, cashBookId, journalEntryId])
  @@index([ownerId, cashBookId, businessDate])
}

model CashCloseRecord {
  id           String   @id
  ownerId      String
  cashBookId   String
  businessDate DateTime
  payload      String
  checksum     String
  signedBy     String
  approvedBy   String
  closedAt     DateTime

  @@unique([ownerId, cashBookId, businessDate])
  @@index([ownerId, closedAt])
}

model DocumentRecord {
  id                  String                      @id
  payload             String
  ownerId             String?
  availableForBooking Boolean                     @default(true)
  attachments         JournalDocumentAttachment[]
  structuredInvoice   StructuredInvoice?
  commercialDocuments CommercialDocument[]
  extraction          DocumentExtraction?

  @@unique([ownerId, id])
  @@index([ownerId])
  @@index([ownerId, availableForBooking])
}

model DocumentExtraction {
  id               String         @id @default(cuid())
  ownerId          String
  documentId       String         @unique
  document         DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Restrict)
  status           String
  provider         String
  providerVersion  String
  inputHash        String
  attempt          Int            @default(1)
  extractedData    String?
  rawTextHash      String?
  failureCode      String?
  failureMessage   String?
  retryable        Boolean        @default(false)
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([ownerId, documentId])
  @@index([ownerId, status, updatedAt])
  @@index([ownerId, inputHash])
}

model DocumentStorageClaim {
  id             String   @id
  importId       String
  documentId     String
  ownerId        String
  storageKey     String
  createdStorage Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([importId, documentId])
  @@index([documentId])
  @@index([createdAt])
}

model RetainedArtifact {
  id                  String    @id @default(cuid())
  ownerId             String
  objectType          String
  objectId            String
  version             Int
  retentionClass      String
  contentHash         String
  provenance          String
  storageKey          String?
  periodEndsAt        DateTime
  retainUntil         DateTime
  legalHoldUntil      DateTime?
  legalHoldReason     String?
  lastFixityAt        DateTime?
  disposedAt          DateTime?
  disposalRequestedAt DateTime?
  storageDeletedAt    DateTime?
  createdAt           DateTime  @default(now())

  @@unique([ownerId, objectType, objectId, version])
  @@index([ownerId, retainUntil, legalHoldUntil])
}

model FixityCheck {
  id           String   @id @default(cuid())
  ownerId      String
  artifactId   String
  expectedHash String
  actualHash   String?
  status       String
  readable     Boolean
  checkedAt    DateTime @default(now())

  @@index([ownerId, artifactId, checkedAt])
}

model BookingRecordEntry {
  id      String @id
  payload String
}

model LedgerAccount {
  id              String        @id @default(cuid())
  ownerId         String
  number          Int
  name            String
  category        String
  eBilanzPosition String?
  active          Boolean       @default(true)
  journalLines    JournalLine[]
  bankAccounts    BankAccount[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([ownerId, number])
  @@unique([ownerId, id])
}

model BankAccount {
  id              String            @id @default(cuid())
  ownerId         String
  name            String
  iban            String
  currency        String            @default("EUR")
  ledgerAccountId String
  ledgerAccount   LedgerAccount     @relation(fields: [ownerId, ledgerAccountId], references: [ownerId, id], onDelete: Restrict)
  active          Boolean           @default(true)
  statements      BankStatement[]
  transactions    BankTransaction[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([ownerId, id])
  @@unique([ownerId, iban])
  @@index([ownerId, active])
}

model BankStatement {
  id                  String            @id @default(cuid())
  ownerId             String
  bankAccountId       String
  bankAccount         BankAccount       @relation(fields: [ownerId, bankAccountId], references: [ownerId, id], onDelete: Restrict)
  externalStatementId String
  format              String            @default("CAMT053")
  contentHash         String
  originalXml         Bytes
  periodStart         DateTime
  periodEnd           DateTime
  openingBalanceCents Int
  closingBalanceCents Int
  currency            String            @default("EUR")
  importedBy          String
  transactions        BankTransaction[]
  importedAt          DateTime          @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, bankAccountId, externalStatementId])
  @@unique([ownerId, bankAccountId, contentHash])
  @@index([ownerId, periodEnd])
}

model BankTransaction {
  id               String        @id @default(cuid())
  ownerId          String
  bankAccountId    String
  bankAccount      BankAccount   @relation(fields: [ownerId, bankAccountId], references: [ownerId, id], onDelete: Restrict)
  statementId      String
  statement        BankStatement @relation(fields: [ownerId, statementId], references: [ownerId, id], onDelete: Restrict)
  externalKey      String
  factHash         String
  amountCents      Int
  currency         String        @default("EUR")
  bookingDate      DateTime
  valueDate        DateTime?
  bankReference    String?
  counterpartyName String?
  counterpartyIban String?
  remittance       String?
  rawData          String
  matches          BankTransactionMatch[]
  createdAt        DateTime      @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, bankAccountId, externalKey])
  @@index([ownerId, bankAccountId, bookingDate])
}

model BankTransactionMatch {
  id                   String               @id @default(cuid())
  ownerId              String
  bankTransactionId    String
  bankTransaction      BankTransaction      @relation(fields: [ownerId, bankTransactionId], references: [ownerId, id], onDelete: Restrict)
  openItemId           String
  openItem             OpenItem             @relation(fields: [ownerId, openItemId], references: [ownerId, id], onDelete: Restrict)
  settlementId         String
  settlement           PaymentSettlement    @relation(fields: [ownerId, settlementId], references: [ownerId, id], onDelete: Restrict)
  allocationId         String
  allocation           SettlementAllocation @relation(fields: [ownerId, allocationId], references: [ownerId, id], onDelete: Restrict)
  journalEntryId       String
  journalEntry         JournalEntry         @relation(fields: [ownerId, journalEntryId], references: [ownerId, id], onDelete: Restrict)
  kind                 String
  amountCents          Int
  requestKey           String
  requestHash          String
  reversesMatchId      String?
  reverses             BankTransactionMatch? @relation("BankMatchReversal", fields: [ownerId, reversesMatchId], references: [ownerId, id], onDelete: Restrict)
  reversedBy           BankTransactionMatch[] @relation("BankMatchReversal")
  effectiveDate        DateTime
  createdBy            String
  createdAt            DateTime             @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, requestKey])
  @@unique([ownerId, journalEntryId])
  @@unique([ownerId, allocationId])
  @@unique([ownerId, reversesMatchId])
  @@index([ownerId, bankTransactionId, createdAt])
}

model AccountMappingVersion {
  id               String    @id @default(cuid())
  ownerId          String
  chartId          String
  accountNumber    Int
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  accountName      String
  accountType      String
  normalBalance    String
  presentationSign Int       @default(1)
  hgbPosition      String
  eBilanzPosition  String
  vatCode          String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@unique([ownerId, chartId, accountNumber, effectiveFrom])
  @@index([ownerId, effectiveFrom, effectiveTo])
}

model LedgerProfile {
  ownerId          String  @id
  chart            String
  consultantNumber String?
  clientNumber     String?
  accountLength    Int?
}

model LexwareCompanySetup {
  id               String   @id @default(cuid())
  ownerId          String
  year             Int
  companyName      String
  street           String
  postalCode       String
  city             String
  region           String
  phone            String?
  fax              String?
  currency         String
  accountingMethod String
  chart            String
  startsAt         DateTime
  endsAt           DateTime
  taxonomyVersion  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ownerId, year])
  @@index([ownerId, startsAt, endsAt])
}

model LexwareAccountMetadata {
  id                             String   @id @default(cuid())
  ownerId                        String
  year                           Int
  accountNumber                  Int
  accountName                    String
  accountCategory                String
  subcategory                    String?
  legacyVatPosition              String?
  legacyVatCode                  String?
  currentVatPosition             String?
  currentVatCode                 String?
  cashBasisMapping               String?
  hgbAssetMapping                String?
  hgbLiabilityMapping            String?
  hgbIncomeStatementMapping      String?
  taxonomyAssetMapping           String?
  taxonomyLiabilityMapping       String?
  taxonomyIncomeStatementMapping String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@unique([ownerId, year, accountNumber])
  @@index([ownerId, year])
}

model LexwareTrialBalanceLine {
  id                    String    @id @default(cuid())
  ownerId               String
  year                  Int
  accountNumber         Int
  accountName           String
  lastBookingDate       DateTime?
  openingDebitCents     Int
  openingCreditCents    Int
  annualDebitCents      Int
  annualCreditCents     Int
  cumulativeDebitCents  Int
  cumulativeCreditCents Int
  closingDebitCents     Int
  closingCreditCents    Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([ownerId, year, accountNumber])
  @@index([ownerId, year])
}

model LexwareBusinessPartner {
  id            String   @id @default(cuid())
  ownerId       String
  year          Int
  partnerNumber String
  name          String
  street        String
  houseNumber   String
  postalCode    String
  city          String
  industry      String?
  vatId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerId, year, partnerNumber])
  @@index([ownerId, year, name])
}

model LexwareSubledgerAssociation {
  id            String   @id @default(cuid())
  ownerId       String
  year          Int
  accountNumber Int
  partnerNumber String
  kind          String
  createdAt     DateTime @default(now())

  @@unique([ownerId, year, accountNumber, partnerNumber, kind])
  @@index([ownerId, year, kind])
}

model LexwareAnnualVatField {
  id          String   @id @default(cuid())
  ownerId     String
  year        Int
  fieldCode   String
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, year, fieldCode])
  @@index([ownerId, year])
}

model FiscalYear {
  id                  String                  @id @default(cuid())
  ownerId             String
  year                Int
  label               String?
  startsAt            DateTime
  endsAt              DateTime
  status              String                  @default("OPEN")
  lockedAt            DateTime?
  closingSnapshot     String?
  journalEntries      JournalEntry[]
  eBalanceSubmissions EBalanceSubmission[]
  hgbCloseRuns        HgbCloseRun[]
  closeGenerations    FiscalCloseGeneration[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([ownerId, year])
  @@unique([ownerId, id])
  @@unique([ownerId, startsAt, endsAt])
  @@index([ownerId, startsAt, endsAt])
}

model HgbCloseRun {
  id                String                  @id @default(cuid())
  ownerId           String
  fiscalPeriodId    String
  fiscalPeriod      FiscalYear              @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  version           Int
  status            String
  ruleSetVersion    String
  ledgerFingerprint String
  inputChecksum     String
  checksum          String
  payload           String
  createdBy         String
  createdAt         DateTime                @default(now())
  closeGenerations  FiscalCloseGeneration[]

  @@unique([ownerId, fiscalPeriodId, version])
  @@unique([ownerId, checksum])
  @@index([ownerId, fiscalPeriodId, createdAt])
}

model FiscalCloseGeneration {
  id                  String                        @id @default(cuid())
  ownerId             String
  fiscalYearId        String
  fiscalYear          FiscalYear                    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  generation          Int
  hgbCloseRunId       String
  hgbCloseRun         HgbCloseRun                   @relation(fields: [hgbCloseRunId], references: [id], onDelete: Restrict)
  hgbCloseRunChecksum String
  snapshotHash        String
  lockedAt            DateTime
  createdAt           DateTime                      @default(now())
  eBalanceSubmissions EBalanceSubmission[]
  eBalanceReports     EBalanceLifecycleReport[]
  annualTaxCases      TaxAnnualCaseRecord[]
  taxPreparations     TaxDatasetPreparationRecord[]

  @@unique([ownerId, fiscalYearId, generation])
  @@unique([ownerId, fiscalYearId, lockedAt])
  @@index([ownerId, fiscalYearId, createdAt])
  @@index([hgbCloseRunId])
}

model HgbWorkpaperRecord {
  id             String    @id @default(cuid())
  ownerId        String
  fiscalPeriodId String
  kind           String
  version        Int
  status         String    @default("DRAFT")
  ruleSetVersion String
  payload        String
  checksum       String
  preparedBy     String?
  preparedAt     DateTime?
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewReason   String?
  supersedesId   String?
  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ownerId, fiscalPeriodId, kind, version])
  @@unique([ownerId, checksum])
  @@index([ownerId, fiscalPeriodId, status])
}

model HgbAdjustmentRecord {
  id             String    @id @default(cuid())
  ownerId        String
  fiscalPeriodId String
  workpaperId    String
  proposalId     String
  fingerprint    String
  status         String    @default("PROPOSED")
  idempotencyKey String?
  postedEntryId  String?
  postedBy       String?
  postedAt       DateTime?
  payload        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ownerId, workpaperId, proposalId])
  @@unique([ownerId, fingerprint])
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, fiscalPeriodId, status])
}

model EBalanceSubmission {
  id                String                 @id @default(cuid())
  ownerId           String
  year              Int
  fiscalYearId      String
  fiscalYear        FiscalYear             @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  closeGenerationId String?
  closeGeneration   FiscalCloseGeneration? @relation(fields: [closeGenerationId], references: [id], onDelete: Restrict)
  kind              String
  status            String
  idempotencyKey    String
  payloadHash       String
  requestHash       String
  requestXml        String
  ericCode          Int?
  ericMessage       String?
  resultXml         String?
  serverResponseXml String?
  createdAt         DateTime               @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, year, createdAt])
  @@index([closeGenerationId])
}

model EBalanceTaxonomyRelease {
  version           String   @id
  validFrom         DateTime
  validThrough      DateTime
  gaapNamespace     String
  gcdNamespace      String
  entryPoint        String
  archiveSha256     String   @unique
  archiveStorageKey String
  successorVersion  String?
  compatibility     String
  registeredBy      String
  registeredAt      DateTime @default(now())

  @@index([validFrom, validThrough])
}

model EBalanceLifecycleReport {
  id                    String                 @id
  ownerId               String
  fiscalYearId          String
  closeGenerationId     String?
  closeGeneration       FiscalCloseGeneration? @relation(fields: [closeGenerationId], references: [id], onDelete: Restrict)
  version               Int
  status                String
  taxonomyVersion       String
  profileSnapshot       String
  reportPayload         String
  reportXml             String
  reportChecksum        String
  validationDiagnostics String?
  validationEngine      String?
  validatedAt           DateTime?
  storageKey            String
  supersedesId          String?
  approvedBy            String?
  approvedAt            DateTime?
  createdBy             String
  createdAt             DateTime               @default(now())

  @@unique([ownerId, fiscalYearId, version])
  @@unique([ownerId, closeGenerationId, reportChecksum])
  @@index([ownerId, fiscalYearId, createdAt])
  @@index([closeGenerationId])
}

model EBalanceReconciliationRecord {
  id           String   @id
  ownerId      String
  fiscalYearId String
  kind         String
  payload      String
  checksum     String
  evidenceIds  String
  approvedBy   String
  approvedAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([ownerId, fiscalYearId, kind, id])
  @@unique([ownerId, fiscalYearId, kind, checksum])
  @@index([ownerId, fiscalYearId, kind])
}

model JournalEntry {
  id                    String                      @id @default(cuid())
  ownerId               String
  sequenceNumber        Int
  bookingDate           DateTime
  sourcePostingDate     DateTime?
  sourceJournalDate     DateTime?
  sourcePeriod          Int?
  documentNumber        String
  description           String
  source                String                      @default("MANUAL")
  state                 String                      @default("POSTED")
  entryDate             DateTime?                   @default(now())
  lateReason            String?
  reversalOfId          String?                     @unique
  replacementOfId       String?                     @unique
  externalKey           String?                     @unique
  fiscalYearId          String
  fiscalYear            FiscalYear                  @relation(fields: [ownerId, fiscalYearId], references: [ownerId, id], onDelete: Restrict)
  lines                 JournalLine[]
  documents             JournalDocumentAttachment[]
  commercialDocuments   CommercialDocument[]
  paymentSettlements    PaymentSettlement[]
  settlementAllocations SettlementAllocation[]
  correctionNettings     CorrectionNetting[]
  bankTransactionMatches BankTransactionMatch[]
  createdAt             DateTime                    @default(now())

  @@unique([fiscalYearId, sequenceNumber])
  @@unique([fiscalYearId, documentNumber])
  @@unique([ownerId, id])
  @@index([bookingDate])
}

model JournalDraft {
  id            String   @id @default(cuid())
  ownerId       String
  fiscalYearId  String
  payload       String
  version       Int      @default(1)
  status        String   @default("DRAFT")
  postedEntryId String?
  createdBy     String
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId, fiscalYearId, status])
}

model PeriodReopenRequest {
  id                String    @id @default(cuid())
  ownerId           String
  fiscalYearId      String
  requestedBy       String
  closeGenerationAt DateTime?
  approvedBy        String?
  reason            String
  status            String
  requestedAt       DateTime  @default(now())
  decidedAt         DateTime?

  @@index([ownerId, fiscalYearId, requestedAt])
}

model FilingAmendment {
  id               String   @id @default(cuid())
  ownerId          String
  kind             String
  originalObjectId String
  requestPayload   String
  responsePayload  String?
  receiptPayload   String?
  reason           String
  status           String   @default("DRAFT")
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([ownerId, kind, originalObjectId, createdAt])
}

model JournalDocumentAttachment {
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  documentId     String
  document       DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([journalEntryId, documentId])
  @@index([documentId])
}

model JournalLine {
  id                 String            @id @default(cuid())
  journalEntryId     String
  journalEntry       JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  accountId          String
  account            LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debitCents         Int               @default(0)
  creditCents        Int               @default(0)
  taxCode            String?
  taxPoint           DateTime?
  taxJurisdiction    String?
  netBaseCents       Int?
  taxRateBasisPoints Int?
  taxAmountCents     Int?
  deductibleTaxCents Int?
  taxRuleId          String?
  taxRuleVersion     Int?
  taxReason          String?
  vatPosting         VatPostingRecord?

  @@index([accountId])
}

model StructuredInvoice {
  id                 String              @id @default(cuid())
  ownerId            String
  documentId         String              @unique
  document           DocumentRecord      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  syntax             String
  kind               String
  direction          String
  issuerKey          String
  invoiceNumber      String
  issueDate          DateTime
  structuredHash     String
  visualHash         String?
  originalMediaType  String
  structuredOriginal Bytes
  visualOriginal     Bytes?
  data               String
  provenance         String
  renderedHtml       String
  correctsId         String?
  commercialDocument CommercialDocument?
  createdAt          DateTime            @default(now())

  @@unique([ownerId, direction, issuerKey, invoiceNumber])
  @@unique([ownerId, structuredHash])
  @@unique([ownerId, id])
  @@index([ownerId, issueDate])
  @@index([ownerId, correctsId])
}

model BusinessPartner {
  id                  String               @id @default(cuid())
  ownerId             String
  partnerNumber       String
  role                String
  name                String
  contactName         String?
  email               String?
  street              String?
  houseNumber         String?
  postalCode          String?
  city                String?
  countryCode         String               @default("DE")
  vatId               String?
  taxId               String?
  paymentTermDays     Int                  @default(14)
  active              Boolean              @default(true)
  version             Int                  @default(1)
  commercialDocuments CommercialDocument[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paymentSettlements  PaymentSettlement[]

  @@unique([ownerId, id])
  @@unique([ownerId, partnerNumber])
  @@index([ownerId, name])
  @@index([ownerId, vatId])
}

model CommercialDocument {
  id                    String               @id @default(cuid())
  ownerId               String
  businessPartnerId     String
  businessPartner       BusinessPartner      @relation(fields: [ownerId, businessPartnerId], references: [ownerId, id], onDelete: Restrict)
  structuredInvoiceId   String?
  structuredInvoice     StructuredInvoice?   @relation(fields: [ownerId, structuredInvoiceId], references: [ownerId, id], onDelete: Restrict)
  evidenceDocumentId    String?
  evidenceDocument      DocumentRecord?      @relation(fields: [ownerId, evidenceDocumentId], references: [ownerId, id], onDelete: Restrict)
  postingJournalEntryId String?
  postingJournalEntry   JournalEntry?        @relation(fields: [ownerId, postingJournalEntryId], references: [ownerId, id], onDelete: Restrict)
  correctsId            String?
  corrects              CommercialDocument?  @relation("CommercialDocumentCorrection", fields: [ownerId, correctsId], references: [ownerId, id], onDelete: Restrict)
  correctedBy           CommercialDocument[] @relation("CommercialDocumentCorrection")
  direction             String
  kind                  String
  status                String               @default("DRAFT")
  documentNumber        String?
  documentIdentityKey   String?
  issueDate             DateTime?
  serviceDate           DateTime
  dueDate               DateTime
  description           String
  currency              String               @default("EUR")
  netAmountCents        Int
  taxAmountCents        Int
  grossAmountCents      Int
  payableAmountCents    Int
  counterpartySnapshot  String?
  version               Int                  @default(1)
  openItem              OpenItem?
  correctionNetting     CorrectionNetting?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([ownerId, id])
  @@unique([ownerId, direction, documentIdentityKey])
  @@unique([ownerId, structuredInvoiceId])
  @@index([ownerId, businessPartnerId, serviceDate])
  @@index([ownerId, status, dueDate])
  @@index([ownerId, postingJournalEntryId])
  @@index([ownerId, correctsId])
}

model OpenItem {
  id                   String                 @id @default(cuid())
  ownerId              String
  commercialDocumentId String
  commercialDocument   CommercialDocument     @relation(fields: [ownerId, commercialDocumentId], references: [ownerId, id], onDelete: Restrict)
  side                 String
  currency             String
  originalAmountCents  Int
  allocatedAmountCents Int                    @default(0)
  status               String                 @default("OPEN")
  version              Int                    @default(1)
  allocations          SettlementAllocation[]
  correctionNettingsAsDebit  CorrectionNetting[] @relation("CorrectionNettingDebit")
  correctionNettingsAsCredit CorrectionNetting[] @relation("CorrectionNettingCredit")
  bankTransactionMatches BankTransactionMatch[]
  receivablesReminders    ReceivablesReminder[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([ownerId, id])
  @@unique([ownerId, commercialDocumentId])
  @@index([ownerId, status, updatedAt])
}

model CorrectionNetting {
  id                         String             @id @default(cuid())
  ownerId                    String
  correctionDocumentId       String
  correctionDocument         CommercialDocument @relation(fields: [ownerId, correctionDocumentId], references: [ownerId, id], onDelete: Restrict)
  originalOpenItemId         String
  originalOpenItem           OpenItem           @relation("CorrectionNettingDebit", fields: [ownerId, originalOpenItemId], references: [ownerId, id], onDelete: Restrict)
  creditOpenItemId           String
  creditOpenItem             OpenItem           @relation("CorrectionNettingCredit", fields: [ownerId, creditOpenItemId], references: [ownerId, id], onDelete: Restrict)
  journalEntryId             String
  journalEntry               JournalEntry       @relation(fields: [ownerId, journalEntryId], references: [ownerId, id], onDelete: Restrict)
  amountCents                Int
  requestKey                 String
  requestHash                String
  effectiveDate              DateTime
  createdBy                  String
  createdAt                  DateTime           @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, correctionDocumentId])
  @@unique([ownerId, creditOpenItemId])
  @@unique([ownerId, requestKey])
  @@index([ownerId, originalOpenItemId, createdAt])
}

model ReceivablesReminder {
  id                   String                          @id @default(cuid())
  ownerId              String
  openItemId           String
  openItem             OpenItem                        @relation(fields: [ownerId, openItemId], references: [ownerId, id], onDelete: Restrict)
  level                 Int
  requestKey            String
  requestHash           String
  issuedOn              DateTime
  paymentDueDate        DateTime
  originalDueDate       DateTime
  remainingAmountCents  Int
  currency              String
  invoiceNumber         String
  partnerSnapshot       String
  issuerSnapshot        String
  printableHtml         String
  createdBy             String
  createdAt             DateTime                        @default(now())
  cancellation          ReceivablesReminderCancellation?
  deliveryAttempts      ReceivablesReminderDeliveryAttempt[]

  @@unique([ownerId, id])
  @@unique([ownerId, requestKey])
  @@unique([ownerId, openItemId, level])
  @@index([ownerId, issuedOn])
}

model ReceivablesReminderDeliveryAttempt {
  id                 String                             @id
  ownerId            String
  reminderId         String
  reminder           ReceivablesReminder                @relation(fields: [ownerId, reminderId], references: [ownerId, id], onDelete: Restrict)
  requestKey         String
  requestHash        String
  recipient          String
  subject            String
  contentHash        String
  attachmentFileName String
  attachmentHash     String
  requestedBy        String
  requestedAt        DateTime                           @default(now())
  result             ReceivablesReminderDeliveryResult?

  @@unique([ownerId, id])
  @@unique([ownerId, requestKey])
  @@index([ownerId, reminderId, requestedAt])
}

model ReceivablesReminderDeliveryResult {
  id                String                             @id
  ownerId           String
  attemptId         String
  attempt           ReceivablesReminderDeliveryAttempt @relation(fields: [ownerId, attemptId], references: [ownerId, id], onDelete: Restrict)
  status            String
  providerMessageId String?
  failureCode       String?
  failureMessage    String?
  respondedAt       DateTime                           @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, attemptId])
  @@index([ownerId, status, respondedAt])
}

model ReceivablesReminderCancellation {
  id          String              @id @default(cuid())
  ownerId     String
  reminderId  String
  reminder    ReceivablesReminder @relation(fields: [ownerId, reminderId], references: [ownerId, id], onDelete: Restrict)
  requestKey  String
  requestHash String
  cancelledOn DateTime
  reason      String
  createdBy   String
  createdAt   DateTime            @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, reminderId])
  @@unique([ownerId, requestKey])
  @@index([ownerId, cancelledOn])
}

model PaymentSettlement {
  id                   String                 @id @default(cuid())
  ownerId              String
  businessPartnerId    String
  businessPartner      BusinessPartner        @relation(fields: [ownerId, businessPartnerId], references: [ownerId, id], onDelete: Restrict)
  journalEntryId       String
  journalEntry         JournalEntry           @relation(fields: [ownerId, journalEntryId], references: [ownerId, id], onDelete: Restrict)
  direction            String
  currency             String
  amountCents          Int
  allocatedAmountCents Int                    @default(0)
  status               String                 @default("UNALLOCATED")
  version              Int                    @default(1)
  allocations          SettlementAllocation[]
  bankTransactionMatches BankTransactionMatch[]
  occurredOn           DateTime
  createdBy            String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([ownerId, id])
  @@unique([ownerId, journalEntryId])
  @@index([ownerId, businessPartnerId, status, occurredOn])
}

model SettlementAllocation {
  id                   String                 @id @default(cuid())
  ownerId              String
  openItemId           String
  openItem             OpenItem               @relation(fields: [ownerId, openItemId], references: [ownerId, id], onDelete: Restrict)
  settlementId         String
  settlement           PaymentSettlement      @relation(fields: [ownerId, settlementId], references: [ownerId, id], onDelete: Restrict)
  journalEntryId       String
  journalEntry         JournalEntry           @relation(fields: [ownerId, journalEntryId], references: [ownerId, id], onDelete: Restrict)
  kind                 String
  amountCents          Int
  requestKey           String
  requestHash          String
  reversesAllocationId String?
  reverses             SettlementAllocation?  @relation("SettlementReversal", fields: [ownerId, reversesAllocationId], references: [ownerId, id], onDelete: Restrict)
  reversedBy           SettlementAllocation[] @relation("SettlementReversal")
  bankTransactionMatch BankTransactionMatch?
  effectiveDate        DateTime
  createdBy            String
  createdAt            DateTime               @default(now())

  @@unique([ownerId, id])
  @@unique([ownerId, requestKey])
  @@unique([ownerId, reversesAllocationId])
  @@index([ownerId, openItemId, createdAt])
  @@index([ownerId, settlementId, createdAt])
  @@index([ownerId, journalEntryId])
}

model InvoiceNumberSequence {
  ownerId   String
  year      Int
  nextValue Int    @default(1)

  @@id([ownerId, year])
}

model InvoiceNumberSequenceOnboarding {
  ownerId               String
  year                  Int
  firstUnusedNumber     Int
  importedHighestNumber Int?
  importedCount         Int
  importedNumbersHash   String
  confirmedBy           String
  reconciledAt          DateTime @default(now())

  @@id([ownerId, year])
}

model InvoiceNumberReservation {
  id                  String   @id @default(cuid())
  ownerId             String
  year                Int
  sequenceValue       Int
  invoiceNumber       String
  status              String
  structuredInvoiceId String?
  failureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([ownerId, year, sequenceValue])
  @@unique([ownerId, invoiceNumber])
  @@index([ownerId, status, createdAt])
}

model InvoiceIssuanceRequest {
  id                  String   @id @default(cuid())
  ownerId             String
  requestKey          String
  requestHash         String
  status              String   @default("PROCESSING")
  reservationId       String?
  storageKey          String?
  structuredInvoiceId String?
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([ownerId, requestKey])
  @@index([ownerId, status, updatedAt])
}

model VatPostingRecord {
  id                 String       @id @default(cuid())
  ownerId            String
  sourceId           String
  journalLineId      String?      @unique
  journalLine        JournalLine? @relation(fields: [journalLineId], references: [id], onDelete: Restrict)
  documentId         String?
  taxPoint           DateTime
  jurisdiction       String
  netBaseCents       Int
  rateBasisPoints    Int
  taxCents           Int
  deductibleTaxCents Int
  grossCents         Int
  outputTaxCents     Int
  inputTaxCents      Int
  ruleId             String
  ruleVersion        Int
  vatCase            String
  reason             String
  returnBoxes        String
  source             String
  createdAt          DateTime     @default(now())

  @@unique([ownerId, sourceId])
  @@index([ownerId, taxPoint])
  @@index([ownerId, documentId])
}

model VatReversalMarker {
  ownerId   String
  marker    String
  createdAt DateTime @default(now())

  @@id([ownerId, marker])
}

model TaxWorkflowRecord {
  submissionId      String    @id
  ownerId           String
  kind              String
  period            String
  state             String
  revision          Int
  idempotencyKey    String
  payload           String
  receipt           String?
  correctsId        String?
  actionReservation String?
  deadline          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, kind, period, updatedAt])
  @@index([ownerId, correctsId])
}

model TaxSubmissionRequest {
  id           String   @id @default(cuid())
  ownerId      String
  requestKey   String
  datasetHash  String
  filingKey    String?  @unique
  status       String   @default("PROCESSING")
  submissionId String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerId, requestKey])
  @@index([ownerId, createdAt])
}

model TaxAdjustmentRecord {
  id                String
  ownerId           String
  year              Int
  ruleVersion       String
  field             String
  layer             String
  amountCents       Int
  reason            String
  sourceDocumentIds String
  legalBasis        String
  treatment         String
  createdAt         DateTime @default(now())

  @@id([ownerId, id])
  @@index([ownerId, year])
}

model TaxDatasetPreparationRecord {
  id                String                 @id @default(cuid())
  ownerId           String
  kind              String
  period            String
  datasetHash       String
  sourcePayload     String?
  datasetPayload    String?
  sourceChecksum    String?
  ruleVersion       String?
  bindingKind       String?
  closeGenerationId String?
  closeGeneration   FiscalCloseGeneration? @relation(fields: [closeGenerationId], references: [id], onDelete: Restrict)
  annualCaseId      String?
  annualCase        TaxAnnualCaseRecord?   @relation(fields: [annualCaseId], references: [id], onDelete: Restrict)
  createdAt         DateTime               @default(now())

  @@unique([ownerId, datasetHash])
  @@index([ownerId, kind, period, createdAt])
  @@index([closeGenerationId])
  @@index([annualCaseId])
}

model TaxAnnualCaseRecord {
  id                    String                        @id @default(cuid())
  ownerId               String
  year                  Int
  closeGenerationId     String
  closeGeneration       FiscalCloseGeneration         @relation(fields: [closeGenerationId], references: [id], onDelete: Restrict)
  status                String                        @default("PREPARED")
  ruleVersion           String
  legalForm             String
  establishments        Int
  municipalityCode      String
  hebesatzBasisPoints   Int
  foreignIncome         Boolean
  groupOrConsolidation  Boolean
  lossCarry             Boolean
  specialRegime         Boolean
  withholdingOrCredits  Boolean
  payroll               Boolean
  incomeAdjustmentCents Int
  tradeAdjustmentCents  Int
  previewPayload        String
  sourceChecksum        String
  createdBy             String
  createdAt             DateTime                      @default(now())
  preparations          TaxDatasetPreparationRecord[]
  assessments           TaxAssessmentRecord[]

  @@unique([ownerId, sourceChecksum])
  @@index([ownerId, year, createdAt])
  @@index([closeGenerationId])
}

model TaxAssessmentRecord {
  id                      String
  ownerId                 String
  kind                    String
  period                  String
  assessedAmountCents     Int
  receivedAt              DateTime
  documentHash            String
  documentId              String?
  evidenceStorageKey      String?
  authority               String               @default("FINANZAMT")
  noticeId                String?
  noticePayloadHash       String?
  declarationSubmissionId String
  comparisonBasis         String?
  previewRuleVersion      String?
  annualCaseId            String?
  annualCase              TaxAnnualCaseRecord? @relation(fields: [annualCaseId], references: [id], onDelete: Restrict)
  differenceCents         Int
  needsReview             Boolean
  createdAt               DateTime             @default(now())

  @@id([ownerId, id])
  @@unique([ownerId, noticeId])
  @@index([ownerId, kind, period])
  @@index([ownerId, declarationSubmissionId])
  @@index([annualCaseId])
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      AuthAccount[]
  tenantMemberships TenantMembership[]

  @@map("user")
}

model TenantMembership {
  ownerId  String
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([ownerId, userId])
  @@index([userId, ownerId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
